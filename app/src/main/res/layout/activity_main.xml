<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20.dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GoalGrid"
                        android:textColor="#00FFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stay Focused, Stay Productive"
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="48.dp"
                    android:layout_height="48.dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/circle_bg"
                    android:padding="12.dp"
                    android:src="@android:drawable/ic_lock_idle_alarm"
                    app:tint="#00FFFF" />
            </RelativeLayout>

            <!-- Quick Alarm Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="80.dp"
                android:layout_marginTop="20.dp"
                app:cardBackgroundColor="#1A1A1E"
                app:cardCornerRadius="16.dp"
                app:cardElevation="0.dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="16.dp">

                    <ImageView
                        android:layout_width="24.dp"
                        android:layout_height="24.dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#FF00FF" />

                    <EditText
                        android:id="@+id/quickNoteInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12.dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Quick Alarm Note..."
                        android:textColor="@android:color/white"
                        android:textColorHint="#444444" />

                    <ImageButton
                        android:id="@+id/addQuickAlarm"
                        android:layout_width="36.dp"
                        android:layout_height="36.dp"
                        android:background="@drawable/circle_bg_cyan"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@android:color/black" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Tab Switcher -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20.dp"
            android:background="@drawable/tab_bg"
            app:tabIndicatorHeight="0dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="#00FFFF"
            app:tabTextColor="#888888">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Habits" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Content Area -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24.dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#00FFFF"
        app:tint="@android:color/black" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
